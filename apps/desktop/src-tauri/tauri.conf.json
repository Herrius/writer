{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "writer",
  "version": "0.2.0",
  "identifier": "com.writer.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../../ui build",
    "frontendDist": "../../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "writer",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Escritura con archivos como fuente de verdad",
    "longDescription": "Proyecto de escritura con Markdown, historial, búsqueda FTS5 y exportación DOCX.",
    "copyright": "© 2026 writer"
  }
}
