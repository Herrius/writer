{
  "name": "writer-workspace",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "check": "pnpm --dir apps/desktop check",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "ui:dev": "pnpm --dir ui dev",
    "ui:build": "pnpm --dir ui build",
    "ui:test": "pnpm --dir ui test",
    "typecheck": "pnpm --dir ui typecheck",
    "e2e:tauri": "bash scripts/e2e-tauri.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "webdriverio": "10.1.0"
  }
}
